{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patriasoul.github.io/Patriasoul-portal/content-engine/schema/article.schema.json",
  "title": "PatriaSoul Article",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "category", "date", "deck", "content", "sources"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 10},
    "category": {"type": "string", "minLength": 2},
    "subcategory": {"type": "string"},
    "rubric": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "deck": {"type": "string", "minLength": 20},
    "content": {"type": "string", "minLength": 50},
    "image": {"type": "string", "format": "uri"},
    "imageAlt": {"type": "string"},
    "imageCaption": {"type": "string"},
    "place": {"type": "string"},
    "period": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 2},
          "url": {"type": "string", "format": "uri"},
          "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
